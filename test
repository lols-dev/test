                    <style>
                        .hidden {
                            display: none !important;
                            /* Ensure this rule takes precedence */
                        }


                        #game-player {
                            position: relative;
                            width: 100%;
                        }

                        #game-player iframe {
                            border: none;
                            display: block;
                        }

                        #bottom-bar {
                            display: none;
                            /* Hidden by default, only shown in fullscreen */
                        }

                        /* Fullscreen styles */
                        #game-player:fullscreen {
                            background: black;
                            position: relative;
                            /* Needed for absolute positioning of bottom-bar */
                        }

                        #game-player:fullscreen iframe {
                            height: 100vh;
                            width: 100%;
                            max-height: 100%;
                        }

                        .calc-height {
                            height: calc(100vh - 50px) !important;
                        }

                        #game-player:fullscreen #bottom-bar {
                            display: block;
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            right: 0;
                            height: 50px;
                            background-image: linear-gradient(to right, #001377, #fe191e) !important;
                            z-index: 1000;
                        }

                        /* Vendor prefixes for better browser support */
                        #game-player:-webkit-full-screen {
                            background: black;
                            position: relative;
                        }

                        #game-player:-webkit-full-screen iframe {
                            /* height: calc(100vh - 50px) !; */
                            width: 100%;
                        }

                        #game-player:-webkit-full-screen #bottom-bar {
                            display: block;
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            right: 0;
                            height: 50px;
                            background-image: linear-gradient(to right, #001377, #fe191e) !important;
                            z-index: 1000;
                        }

                        #game-player:-moz-full-screen {
                            background: black;
                            position: relative;
                        }

                        #game-player:-moz-full-screen iframe {
                            height: calc(100vh - 50px) !important;
                            width: 100%;
                        }

                        #game-player:-moz-full-screen #bottom-bar {
                            display: block;
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            right: 0;
                            height: 50px;
                            background-image: linear-gradient(to right, #001377, #fe191e) !important;
                            z-index: 1000;
                        }

                        /* iOS-specific fullscreen styles */
                        @media screen and (-webkit-min-device-pixel-ratio: 0) {
                            #game-player iframe {
                                -webkit-playsinline: true;
                            }
                        }

                        /* Ensure iframe is properly sized for iOS fullscreen */
                        #game-player iframe:fullscreen {
                            width: 100vw !important;
                            height: 100vh !important;
                            border: none !important;
                        }

